# =============================================================================
# MesaOn — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e configure também na hospedagem.
# NUNCA faça commit de .env.local.
# =============================================================================

# --- Supabase (Project Settings → API) ---------------------------------------
# URL do projeto
NEXT_PUBLIC_SUPABASE_URL=https://gcajtgzkurmfgyaglgim.supabase.co
# Chave PUBLICÁVEL (sb_publishable_...). Projetos antigos: use a chave "anon"
# em NEXT_PUBLIC_SUPABASE_ANON_KEY no lugar desta.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave SECRETA (sb_secret_...) ou, em projetos antigos, a "service_role".
# Usada SOMENTE no servidor, para o fluxo público da mesa. Nunca exponha.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
# SUPABASE_SERVICE_ROLE_KEY=

# --- Aplicação ------------------------------------------------------------------
# URL pública do site (usada nos QR Codes, links de convite e e-mails).
# Em produção, use o domínio definitivo: os QR Codes impressos apontam para ela.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sal secreto para o hash dos IPs (limite anti-spam, LGPD). Mínimo 32 caracteres.
# Gere com: openssl rand -hex 32
IP_HASH_SALT=troque-por-um-valor-aleatorio-com-pelo-menos-32-caracteres

# E-mail exibido na página de contato (opcional)
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Testes de banco (opcional) ----------------------------------------------------
# PostgreSQL local para `npm run test:db` (cria e apaga bancos temporários).
# DATABASE_TEST_URL=postgres://postgres:postgres@localhost:5432/postgres
